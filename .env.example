# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Port used by a direct Node.js start. The Docker container uses port 3020.
PORT=3020

# Host port published by Docker Compose.
HOST_PORT=3020

# Optional API key for external order automation
SALES_API_KEY=

# Keep true when the app is served through HTTPS. Set false for local HTTP testing.
COOKIE_SECURE=false

# Set true only while creating additional staff accounts, then set false again.
ALLOW_REGISTRATION=false
