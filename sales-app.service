[Unit]
Description=AstryxNodes Sales Management System
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sales
Environment=NODE_ENV=production
Environment=PORT=3020
Environment=DATABASE_PATH=/home/ubuntu/sales/data/sales.db
EnvironmentFile=-/etc/astryx-sales.env
ExecStart=/usr/bin/node /home/ubuntu/sales/server.js
Restart=always
RestartSec=5
UMask=0007
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sales-app

[Install]
WantedBy=multi-user.target
